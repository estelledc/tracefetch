{
  "$defs": {
    "SearchAttempt": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "status"
      ],
      "title": "SearchAttempt",
      "type": "object"
    },
    "SearchCandidate": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "title",
        "url",
        "provider"
      ],
      "title": "SearchCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/SearchAttempt"
      },
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/SearchCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "schema_version": {
      "const": "tracefetch.search.v1",
      "default": "tracefetch.search.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "query",
    "candidates",
    "attempts"
  ],
  "title": "SearchEnvelope",
  "type": "object"
}
